{
  "name": "prompt-by-prompt",
  "displayName": "Prompt by Prompt",
  "description": "An AI task-pack workbench for VS Code: gather context, clarify agent work, save Copilot prompt files, and bootstrap workspace AI customizations.",
  "version": "4.0.0",
  "publisher": "aknirex",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aknirex/prompt-by-prompt.git"
  },
  "homepage": "https://github.com/Aknirex/prompt-by-prompt#readme",
  "license": "GPL-3.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.105.0",
    "node": "^20.20.2"
  },
  "packageManager": "pnpm@10.33.0",
  "volta": {
    "node": "20.20.2",
    "pnpm": "10.33.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "prompt",
    "prompt-files",
    "vibe-coding",
    "context-engineering"
  ],
  "activationEvents": [
    "onView:pbp.workbenchView",
    "onCommand:pbp.refreshWorkbench",
    "onCommand:pbp.newTaskPack",
    "onCommand:pbp.addSelectionContext",
    "onCommand:pbp.addCurrentFileContext",
    "onCommand:pbp.addFilesContext",
    "onCommand:pbp.addGitDiffContext",
    "onCommand:pbp.addDiagnosticsContext",
    "onCommand:pbp.addNoteContext",
    "onCommand:pbp.copyTaskPack",
    "onCommand:pbp.previewTaskPack",
    "onCommand:pbp.savePromptFile",
    "onCommand:pbp.bootstrapWorkspace",
    "onCommand:pbp.auditCustomizations",
    "onCommand:pbp.refineTaskPack",
    "onCommand:pbp.clearTaskPack",
    "onCommand:pbp.removeContextItem"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pbp.refreshWorkbench",
        "title": "Prompt by Prompt: Refresh Workbench",
        "icon": "$(refresh)"
      },
      {
        "command": "pbp.newTaskPack",
        "title": "Prompt by Prompt: New Task Pack",
        "icon": "$(add)"
      },
      {
        "command": "pbp.addSelectionContext",
        "title": "Prompt by Prompt: Add Selection or Current Line",
        "icon": "$(selection)"
      },
      {
        "command": "pbp.addCurrentFileContext",
        "title": "Prompt by Prompt: Add Current File",
        "icon": "$(file-code)"
      },
      {
        "command": "pbp.addFilesContext",
        "title": "Prompt by Prompt: Add Files...",
        "icon": "$(files)"
      },
      {
        "command": "pbp.addGitDiffContext",
        "title": "Prompt by Prompt: Add Git Diff",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "pbp.addDiagnosticsContext",
        "title": "Prompt by Prompt: Add Diagnostics",
        "icon": "$(warning)"
      },
      {
        "command": "pbp.addNoteContext",
        "title": "Prompt by Prompt: Add Note",
        "icon": "$(note)"
      },
      {
        "command": "pbp.copyTaskPack",
        "title": "Prompt by Prompt: Copy Task Pack",
        "icon": "$(clippy)"
      },
      {
        "command": "pbp.previewTaskPack",
        "title": "Prompt by Prompt: Preview Task Pack",
        "icon": "$(preview)"
      },
      {
        "command": "pbp.savePromptFile",
        "title": "Prompt by Prompt: Save as Prompt File",
        "icon": "$(save)"
      },
      {
        "command": "pbp.bootstrapWorkspace",
        "title": "Prompt by Prompt: Bootstrap Workspace AI Setup",
        "icon": "$(rocket)"
      },
      {
        "command": "pbp.auditCustomizations",
        "title": "Prompt by Prompt: Audit AI Customizations",
        "icon": "$(shield)"
      },
      {
        "command": "pbp.refineTaskPack",
        "title": "Prompt by Prompt: Refine Task Pack",
        "icon": "$(sparkle)"
      },
      {
        "command": "pbp.clearTaskPack",
        "title": "Prompt by Prompt: Clear Task Pack",
        "icon": "$(trash)"
      },
      {
        "command": "pbp.removeContextItem",
        "title": "Prompt by Prompt: Remove Context Item",
        "icon": "$(close)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pbp-explorer",
          "title": "Prompt by Prompt",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pbp-explorer": [
        {
          "id": "pbp.workbenchView",
          "name": "Task Pack Workbench",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pbp.refreshWorkbench",
          "when": "view == pbp.workbenchView",
          "group": "navigation@1"
        },
        {
          "command": "pbp.newTaskPack",
          "when": "view == pbp.workbenchView",
          "group": "navigation@2"
        },
        {
          "command": "pbp.copyTaskPack",
          "when": "view == pbp.workbenchView",
          "group": "navigation@3"
        },
        {
          "command": "pbp.savePromptFile",
          "when": "view == pbp.workbenchView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "pbp.removeContextItem",
          "when": "view == pbp.workbenchView && viewItem == pbp.contextItem",
          "group": "inline@1"
        }
      ],
      "editor/context": [
        {
          "command": "pbp.newTaskPack",
          "when": "editorTextFocus",
          "group": "pbp@1"
        },
        {
          "command": "pbp.addSelectionContext",
          "when": "editorTextFocus",
          "group": "pbp@2"
        }
      ]
    },
    "configuration": {
      "title": "Prompt by Prompt",
      "properties": {
        "pbp.contextBudgetChars": {
          "type": "number",
          "default": 80000,
          "minimum": 4000,
          "description": "Maximum character budget for task-pack context collection."
        },
        "pbp.includeDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Automatically attach VS Code diagnostics when creating a task pack."
        },
        "pbp.includeGitDiff": {
          "type": "boolean",
          "default": true,
          "description": "Automatically attach the current Git diff when creating a task pack."
        },
        "pbp.enableLanguageModelAssist": {
          "type": "boolean",
          "default": true,
          "description": "Allow optional VS Code Language Model API assistance for refining task packs."
        },
        "pbp.promptFilesPath": {
          "type": "string",
          "default": ".github/prompts",
          "description": "Workspace folder where saved task packs are written as VS Code prompt files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run clean && pnpm run build",
    "clean": "rimraf dist",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "tsc --noEmit",
    "watch": "pnpm run esbuild-base --sourcemap --watch",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies",
    "release": "release-it"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.2.1",
    "ovsx": "^0.10.11",
    "release-it": "^20.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "8.0.10"
    }
  }
}
